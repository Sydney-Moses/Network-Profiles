name: Synthesize Third-Party Services

icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/SSID.png

category: Private

desc: |-
  Synthesize Third-Party Services
  19 Service Availability Tests
  Detection Interval: 1 Hour
  Request Timeout: 10 Seconds


script-providers:

  Service-Availability-YouTube:
    interval: 86400
    url: https://raw.githubusercontent.com/Sydney-Moses/Network-Profiles/refs/heads/main/Customization/JS/Service-Availability.js

