      - ⚙️ 🇳🇱 Primary-NL-Auto
      - ⚙️ 🇳🇱 Backup-NL-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇩🇰 DK-Fallback
    type: fallback
    proxies:
      # - ⚙️ 🇩🇰 Primary-DK-Auto
      - ⚙️ 🇩🇰 Backup-DK-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇵🇪 PE-Fallback
    type: fallback
    proxies:
      # - ⚙️ 🇵🇪 Primary-PE-Auto
      - ⚙️ 🇵🇪 Backup-PE-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇷🇴 RO-Fallback
    type: fallback
    proxies:
      # - ⚙️ 🇷🇴 Primary-RO-Auto
      - ⚙️ 🇷🇴 Backup-RO-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  # ======== AUTO ======== #
  # =========================== #

  - name: ⚙️ 🇺🇸 Primary-US-Auto
    type: url-test
    use:
      - Primary-VPS
    filter: '(?i)(\[US\]|^US$|USA|United States|\bUS\b|美国)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 600
    timeout: 15
    tolerance: 50

  - name: ⚙️ 🇺🇸 Clean-US-Auto
    type: url-test
