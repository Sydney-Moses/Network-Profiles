name: Stash Beta Override
category: Beta

desc: |-
  DNS｜Proxy Groups｜Rules
  Version: 2.4
  Encrypted DNS:
   - DoH｜IPv6｜IPv4
  Policy Groups:
   - PROXY-Gate:Primary/Backup/Clean/US/SG/HK/KR/JP/CA/Other｛UK-DE-FR-IT-NL-DK-PE-RO｝
  Rules:
   - Customize｜CN
   - MATCH -> PROXY-Gate (Default Fallback)

#!override

mixed-port: 7890
allow-lan: true
bind-address: '*'
mode: rule
log-level: info
external-controller: '127.0.0.1:9090'
unified-delay: true
tcp-concurrent: true

tun: #!replace
  enable: true
  stack: gvisor
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53

dns: #!replace
  enable: true
  respect-rules: true
  ipv6: true
  prefer-h3: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
    - 2400:3200::1

  nameserver:
    - https://dns.cloudflare.com/dns-query
    - https://dns.google/dns-query


  nameserver-policy:
    'dns.cloudflare.com':
      - 1.1.1.1
      - 1.0.0.1
    'dns.google':
      - 8.8.8.8
      - 8.8.4.4
    'dns.quad9.net':
      - 9.9.9.9
      - 149.112.112.112
    'dns.alidns.com':
      - 223.5.5.5
      - 223.6.6.6
    'doh.pub':
      - 1.12.12.12
      - 120.53.53.53
    # Proxy Node Domain DNS Policy #

    '+.googlevideo.com':
      - https://dns.google/dns-query
    '+.ctcxianyu.com':
      - https://38.76.213.238:8080/dns-query
    '+.525536.xyz':
      - https://38.76.213.238:8080/dns-query
    '+.t11-a.app':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    '+.t202511-n.icu':
      - https://dns.alidns.com/dns-query
      - https://doh.pub/dns-query
    # Apple
    '+.mzstatic.com':
      - https://dns.alidns.com/dns-query
    '+.itunes.apple.com':
      - https://dns.alidns.com/dns-query
    '+.aaplimg.com':
      - https://dns.alidns.com/dns-query
    # UnionPay
    '+.unionpay.com':
      - https://dns.alidns.com/dns-query
    '+.95516.com':
      - https://dns.alidns.com/dns-query
    # NetEase
    '+.163.com':
      - https://dns.alidns.com/dns-query
    '+.126.com':
      - https://dns.alidns.com/dns-query
    '+.126.net':
      - https://dns.alidns.com/dns-query
    '+.netease.com':
      - https://dns.alidns.com/dns-query
    # Tencent
    '+.weixin.com':
      - https://dns.alidns.com/dns-query
    '+.wechat.com':
      - https://dns.alidns.com/dns-query
    '+.qq.com':
      - https://dns.alidns.com/dns-query
    '+.qpic.cn':
      - https://dns.alidns.com/dns-query
    '+.tencent.com':
      - https://dns.alidns.com/dns-query
    # Meituan
    '+.meituan.com':
      - https://dns.alidns.com/dns-query
    '+.meituan.net':
      - https://dns.alidns.com/dns-query
    '+.sankuai.com':
      - https://dns.alidns.com/dns-query
    # Kugou
    '+.kugou.com':
      - https://dns.alidns.com/dns-query
    '+.kgimg.com':
      - https://dns.alidns.com/dns-query

  fallback:
    - https://dns.quad9.net/dns-query
    - https://dns.adguard-dns.com/dns-query

  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
      - 127.0.0.0/8
      - 0.0.0.0/32

  fake-ip-filter:
    - '*.lan'
    - '*.local'
    - 'localhost'
    - '*.msftconnecttest.com'
    - '*.msftncsi.com'
    - '*.msidentity.com'
    - 'captive.apple.com'
    - '*.push.apple.com'
    - 'stun.*'
    - '+.stun.*.*'
    - '+.stun.*.*.*'
    - '+.stun.*.*.*.*'
    - '+.stun.*.*.*.*.*'
    - '+.weixin.com'
    - '+.wechat.com'
    - '+.qq.com'
    - '+.tencent.com'
    - 'speedtest.net'

profile: #!replace
  store-selected: true
  store-fake-ip: true

#-------------------#
# proxies: #
#-------------------#
proxy-groups: #!replace
  - name: PROXY-Gate
    type: select
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
    proxies:
      - 🔘 Primary-Manual
      - 🔘 Clean-Manual
      - 🔘 Backup-Manual
      - 🌍 Other-Manual
      - 🇺🇸 US-Fallback
      - 🇸🇬 SG-Fallback
      - 🇭🇰 HK-Fallback
      - 🇯🇵 JP-Fallback
      - 🇰🇷 KR-Fallback
      - 🇨🇦 CA-Fallback
      - DIRECT

  # Custom
  - name: 🔘 Primary-Manual
    type: select
    use:
      - Primary-VPS
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Server.png

  - name: 🔘 Clean-Manual
    type: select
    use:
      - Clean-VPS
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Server.png

  - name: 🔘 Backup-Manual
    type: select
    use:
      - Backup-VPS
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Server.png

  # Other-Manual
  - name: 🌍 Other-Manual
    type: select
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    proxies:
      - 🇬🇧 UK-Fallback
      - 🇩🇪 DE-Fallback
      - 🇫🇷 FR-Fallback
      - 🇮🇹 IT-Fallback
      - 🇳🇱 NL-Fallback
      - 🇩🇰 DK-Fallback
      - 🇵🇪 PE-Fallback
      - 🇷🇴 RO-Fallback

  # Fallback
  - name: 🇺🇸 US-Fallback
    type: fallback
    proxies:
      - ⚙️ 🇺🇸 Primary-US-Auto
      - ⚙️ 🇺🇸 Clean-US-Auto
      - ⚙️ 🇺🇸 Backup-US-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/United_States.png
    url: http://www.gstatic.com/generate_204
    interval: 600
    timeout: 15

  - name: 🇸🇬 SG-Fallback
    type: fallback
    proxies:
      - ⚙️ 🇸🇬 Primary-SG-Auto
      - ⚙️ 🇸🇬 Backup-SG-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Singapore.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇭🇰 HK-Fallback
    type: fallback
    proxies:
      - ⚙️ 🇭🇰 Primary-HK-Auto
      - ⚙️ 🇭🇰 Backup-HK-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Hong_Kong.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇯🇵 JP-Fallback
