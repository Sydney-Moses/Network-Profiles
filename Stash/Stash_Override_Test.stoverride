    timeout: 15

  - name: 🇰🇷 KR-Fallback
    type: fallback
    proxies:
      - ⚙️ 🇰🇷 Primary-KR-Auto
      # - ⚙️ 🇰🇷 Backup-KR-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Korea.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇨🇦 CA-Fallback
    type: fallback
    proxies:
      - ⚙️ 🇨🇦 Primary-CA-Auto
