  - name: 🇳🇱 NL-Fallback
    type: fallback
    proxies:
      - ⚙️ 🇳🇱 Primary-NL-Auto
      - ⚙️ 🇳🇱 Backup-NL-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇩🇰 DK-Fallback
    type: fallback
    proxies:
      # - ⚙️ 🇩🇰 Primary-DK-Auto
      - ⚙️ 🇩🇰 Backup-DK-Auto
    icon: https://fastly.jsdelivr.net/gh/Koolson/Qure/IconSet/Color/Global.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15

  - name: 🇵🇪 PE-Fallback
