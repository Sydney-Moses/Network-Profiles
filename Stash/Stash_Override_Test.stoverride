    filter: '(?i)(\[DK\]|^DK$|Denmark|\bDK\b|丹麦|Copenhagen|哥本哈根)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  # - name: ⚙️ 🇵🇪 Primary-PE-Auto
    # type: url-test
    # use:
      # - Primary-VPS
    # filter: '(?i)(\[PE\]|^PE$|Peru|\bPE\b|秘鲁|Lima|利马)'
    # icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    # url: http://www.gstatic.com/generate_204
    # interval: 900
    # timeout: 15
    # tolerance: 50

  - name: ⚙️ 🇵🇪 Backup-PE-Auto
    type: url-test
    use:
      - Backup-VPS
    filter: '(?i)(\[PE\]|^PE$|Peru|\bPE\b|秘鲁|Lima|利马)'
    icon: https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Auto.png
    url: http://www.gstatic.com/generate_204
    interval: 900
    timeout: 15
    tolerance: 50

  # - name: ⚙️ 🇷🇴 Primary-RO-Auto
    # type: url-test
    # use:
      # - Primary-VPS
    # filter: '(?i)(\[RO\]|^RO$|Romania|\bRO\b|罗马尼亚|Bucharest|布加勒斯特)'
